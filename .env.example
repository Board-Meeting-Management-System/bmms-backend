# BMMS API and provisioning worker — local development.
# Copy to .env and fill in the <placeholders>. Never commit .env.
# Generate each 32-byte key once with: openssl rand -base64 32
# Never regenerate a key that is already in use: data encrypted with the old
# key (sessions, tenant credentials, OTP hashes) becomes unreadable.

NODE_ENV=development
HOST=127.0.0.1
PORT=3001

# Exact browser origin of the frontend (CORS, CSRF Origin check, redirects).
FRONTEND_ORIGIN=http://localhost:3000

# Comma-separated reverse-proxy addresses whose X-Forwarded-For is trusted
# (LAN/HTTPS setup only, e.g. 127.0.0.1). Leave unset when not behind a proxy.
# TRUST_PROXY=127.0.0.1

# ---- Databases (compose.yaml; disposable local credentials) ----------------
CONTROL_DATABASE_URL=postgresql://bmms_local:bmms_local_dev@127.0.0.1:5433/bmms_control
# Server-level connection the worker uses to create tenant databases and roles.
PROVISIONING_DATABASE_URL=postgresql://bmms_local:bmms_local_dev@127.0.0.1:5433/postgres
TENANT_DATABASE_HOST=127.0.0.1
TENANT_DATABASE_PORT=5433

# ---- Keycloak (realm "bmms") ------------------------------------------------
OIDC_ISSUER=http://localhost:8080/realms/bmms
OIDC_JWKS_URL=http://localhost:8080/realms/bmms/protocol/openid-connect/certs
OIDC_CLIENT_ID=<keycloak-client-id>
OIDC_CLIENT_SECRET=<keycloak-client-secret>
# Audience the API requires in access tokens.
OIDC_AUDIENCE=<api-audience>
# Must exactly match a Valid Redirect URI of the Keycloak client.
OIDC_REDIRECT_URI=http://localhost:3001/auth/callback

# ---- Keys (base64, 32 bytes each) -------------------------------------------
SESSION_ENCRYPTION_KEY=<base64-32-bytes>
TENANT_SECRETS_KEY_V1=<base64-32-bytes>
EMAIL_OTP_HMAC_KEY=<base64-32-bytes>

# ---- Organizations ----------------------------------------------------------
# Default organization hostnames are <slug>.<PLATFORM_BASE_DOMAIN>.
PLATFORM_BASE_DOMAIN=<platform-domain, e.g. bmms.test>

# ---- Email (Gmail: smtp.gmail.com, 465, true, an App Password) -------------
# smtp sends real email. capture keeps messages in memory and sends nothing
# (automated tests only; refused when NODE_ENV=production).
EMAIL_DELIVERY=smtp
SMTP_HOST=<smtp-host>
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=<smtp-username>
SMTP_PASSWORD=<smtp-app-password>
MAIL_FROM="BMMS <sender@example.com>"
