# BMMS API and provisioning worker — local development.
# Copy to .env and fill in the <placeholders>. Never commit .env.
# Generate each 32-byte key once with: openssl rand -base64 32
# Never regenerate a key that is already in use: data encrypted with the old
# key (sessions, tenant credentials, OTP hashes) becomes unreadable.

NODE_ENV=development
HOST=127.0.0.1
PORT=3001

# Exact browser origin of the frontend (CORS, CSRF Origin check, redirects).
FRONTEND_ORIGIN=http://localhost:3000

# Addresses whose X-Forwarded-Host/-For/-Proto headers are trusted. The
# frontend server forwards organization hostnames this way, so it must be
# listed (127.0.0.1 when it runs on this machine). Nothing else is trusted.
TRUST_PROXY=127.0.0.1

# ---- Databases (compose.yaml; disposable local credentials) ----------------
CONTROL_DATABASE_URL=postgresql://bmms_local:bmms_local_dev@127.0.0.1:5433/bmms_control
# Server-level connection the worker uses to create tenant databases and roles.
PROVISIONING_DATABASE_URL=postgresql://bmms_local:bmms_local_dev@127.0.0.1:5433/postgres
TENANT_DATABASE_HOST=127.0.0.1
TENANT_DATABASE_PORT=5433

# ---- Keycloak (realm "bmms") ------------------------------------------------
OIDC_ISSUER=http://localhost:8080/realms/bmms
OIDC_JWKS_URL=http://localhost:8080/realms/bmms/protocol/openid-connect/certs
OIDC_CLIENT_ID=<keycloak-client-id>
OIDC_CLIENT_SECRET=<keycloak-client-secret>
# Audience the API requires in access tokens.
OIDC_AUDIENCE=<api-audience>
# Must exactly match a Valid Redirect URI of the Keycloak client.
OIDC_REDIRECT_URI=http://localhost:3001/auth/callback

# ---- Keys (base64, 32 bytes each) -------------------------------------------
SESSION_ENCRYPTION_KEY=<base64-32-bytes>
TENANT_SECRETS_KEY_V1=<base64-32-bytes>
EMAIL_OTP_HMAC_KEY=<base64-32-bytes>

# ---- Organization domains ---------------------------------------------------
# local       <slug>.localhost on the dev frontend; browsers resolve *.localhost
#             to this machine. Verifies routing only — never DNS or TLS.
# production  <slug>.<PLATFORM_BASE_DOMAIN> behind preconfigured wildcard DNS,
#             ingress and certificate; verified end to end. Required in production.
DOMAIN_PROVIDER=local
# local: defaults to localhost. production: the registered platform domain.
PLATFORM_BASE_DOMAIN=localhost
# local only: where the domain check reaches the frontend (loopback only).
# LOCAL_ROUTING_CHECK_ORIGIN=http://127.0.0.1:3000
# production only: IPs the wildcard record must resolve to (comma-separated).
# PLATFORM_INGRESS_ADDRESSES=<ingress-ip>[,<ingress-ip>]

# ---- Organization storage ---------------------------------------------------
# local: a 0700 directory per organization. production: not implemented yet
# (provisioning reports STORAGE_PROVIDER_UNSUPPORTED).
STORAGE_PROVIDER=local
TENANT_STORAGE_ROOT=./.storage/tenants

# ---- Email (Gmail: smtp.gmail.com, 465, true, an App Password) -------------
# smtp sends real email. file writes each message to MAIL_CAPTURE_DIR and
# sends nothing (local development). capture keeps messages in memory
# (automated tests). file and capture are refused when NODE_ENV=production.
EMAIL_DELIVERY=smtp
# MAIL_CAPTURE_DIR=./.mail
SMTP_HOST=<smtp-host>
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=<smtp-username>
SMTP_PASSWORD=<smtp-app-password>
MAIL_FROM="BMMS <sender@example.com>"
